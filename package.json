{
  "name": "tanstack-start-aws-high-availability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p edge/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run build:edge && npm run build:sweeper && npm run build:events && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.ts",
    "build:edge": "tsc -p edge/tsconfig.json",
    "test:watch": "vitest",
    "build:sweeper": "esbuild src/workflows/sweeper.ts src/workflows/dispatcher.ts src/workflows/application-consumer.ts src/events/ordered-subscriber.ts --bundle --platform=node --target=node22 --format=cjs --entry-names=[name] --outdir=dist/sweeper",
    "build:events": "esbuild src/events/consumer.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/events/handler.js",
    "dev:poc": "node scripts/orchestration-local.ts",
    "test:poc": "vitest run tests/orchestration-*.test.ts",
    "deploy:poc": "node scripts/deploy-orchestration.ts",
    "cleanup:poc": "node scripts/cleanup-orchestration.ts",
    "verify:poc": "node scripts/verify-orchestration.ts"
  },
  "dependencies": {
    "@ataylorme/tanstack-workflow-aws": "0.2.0-rc.1",
    "@aws-sdk/client-dynamodb": "3.1136.0",
    "@aws-sdk/client-lambda": "3.1136.0",
    "@aws-sdk/client-scheduler": "3.1136.0",
    "@aws-sdk/client-sns": "3.1141.0",
    "@aws-sdk/client-sqs": "3.1141.0",
    "@aws-sdk/lib-dynamodb": "3.1136.0",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "nock": "14.0.17",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
