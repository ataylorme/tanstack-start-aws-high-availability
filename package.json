{
  "name": "tanstack-start-aws-high-availability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p edge/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run build:edge && npm run build:sweeper && npm run build:events && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.ts",
    "build:edge": "tsc -p edge/tsconfig.json",
    "test:watch": "vitest",
    "build:sweeper": "esbuild src/workflows/sweeper.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/sweeper/sweeper.js",
    "build:events": "esbuild src/events/consumer.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/events/handler.js"
  },
  "dependencies": {
    "@ataylorme/tanstack-workflow-aws": "file:vendor/ataylorme-tanstack-workflow-aws-0.2.0-rc.0.tgz",
    "@aws-sdk/client-sqs": "3.1141.0",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
