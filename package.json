{
  "name": "tanstack-start-aws-high-availability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p edge/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run build:edge && npm run typecheck && npm test",
